# Staging Environment Configuration
# Copy this to .env.staging for staging deployment

# ===========================================
# Environment
# ===========================================
NODE_ENV=staging

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ===========================================
# Database Configuration (Staging)
# ===========================================
DB_HOST=your-staging-db-host
DB_PORT=5432
DB_USER=preparation_ai
DB_PASSWORD=your-staging-password
DB_NAME=preparation_ai_staging
DB_SSLMODE=require
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2

# ===========================================
# Redis Configuration (Staging)
# ===========================================
REDIS_HOST=your-staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-staging-redis-password
REDIS_DB=1

# ===========================================
# JWT Configuration (Staging)
# ===========================================
JWT_SECRET=your-staging-jwt-secret-key
JWT_EXPIRATION=24h
JWT_ISSUER=preparation-ai-staging

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=your-staging-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# ===========================================
# Stripe Configuration (Staging)
# ===========================================
STRIPE_SECRET_KEY=sk_test_your-staging-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-staging-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-staging-webhook-secret

# ===========================================
# Frontend Configuration (Staging)
# ===========================================
VITE_API_URL=https://staging-api.yourdomain.com/api/v1
VITE_API_TIMEOUT=10000
VITE_WS_URL=wss://staging-api.yourdomain.com/ws
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-staging-stripe-publishable-key
VITE_NODE_ENV=staging
VITE_DEBUG=true

# ===========================================
# Feature Flags (Staging)
# ===========================================
VITE_ENABLE_AUDIO_RECORDING=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ANALYTICS=false

# ===========================================
# UI Configuration
# ===========================================
VITE_THEME=light
VITE_LANGUAGE=en
VITE_TIMEZONE=UTC

# ===========================================
# Security Configuration
# ===========================================
CORS_ORIGIN=https://staging.yourdomain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ===========================================
# Monitoring and Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ===========================================
# Rate Limiting (More lenient for staging)
# ===========================================
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=15m
