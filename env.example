# ===========================================
# PreparationAI Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# Never commit .env files to version control

# ===========================================
# Environment
# ===========================================
NODE_ENV=development

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=preparation_ai
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_ISSUER=preparation-ai

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
# Any OpenAI-compatible Chat Completions endpoint. For a local engine, point this at it and
# set OPENAI_MODEL to a model it serves; OPENAI_API_KEY may then be left empty, e.g.
#   Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1:8b
#   LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1
# From inside Docker Compose use host.docker.internal instead of localhost.
# Local models can be slow; raise OPENAI_TIMEOUT if requests time out.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60s
# true = sample questions/feedback without calling OpenAI (local development only; rejected in production)
OPENAI_MOCK=false

# ===========================================
# Stripe Configuration
# ===========================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ===========================================
# Frontend Configuration
# ===========================================
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT=10000
VITE_WS_URL=ws://localhost:8080/ws
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
VITE_NODE_ENV=development
VITE_DEBUG=true

# ===========================================
# Feature Flags
# ===========================================
VITE_ENABLE_AUDIO_RECORDING=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ANALYTICS=false

# ===========================================
# UI Configuration
# ===========================================
VITE_THEME=light
VITE_LANGUAGE=en
VITE_TIMEZONE=UTC

# ===========================================
# Production Overrides (uncomment for production)
# ===========================================
# NODE_ENV=production
# DB_SSLMODE=require
# JWT_SECRET=your-production-jwt-secret-here
# VITE_NODE_ENV=production
# VITE_DEBUG=false
# VITE_API_URL=https://api.yourdomain.com/api/v1
