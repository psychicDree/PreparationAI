# ===========================================
# PreparationAI Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# Never commit .env files to version control

# ===========================================
# Environment
# ===========================================
NODE_ENV=development

# ===========================================
# Server Configuration
# ===========================================
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
# Comma-separated list of allowed CORS origins (set to your frontend origin(s) in prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Database Configuration
# ===========================================
# Local Postgres (docker-compose) uses the discrete DB_* vars below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=preparation_ai
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MIN_CONNECTIONS=5

# Supabase Postgres: when DATABASE_URL is set it takes precedence over the
# discrete DB_* vars above. Use the connection string from
# Supabase > Project Settings > Database (use the pooled "Transaction" string
# on port 6543 for serverless/edge, or the direct string on 5432). SSL required.
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.dpfqcrucpbhmqmdjeatg.supabase.co:5432/postgres?sslmode=require

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_ISSUER=preparation-ai

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# ===========================================
# Stripe Configuration
# ===========================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ===========================================
# Frontend Configuration
# ===========================================
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT=10000
VITE_WS_URL=ws://localhost:8080/ws
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
VITE_NODE_ENV=development
VITE_DEBUG=true

# Supabase frontend client (publishable/anon key — safe for the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# ===========================================
# Feature Flags
# ===========================================
VITE_ENABLE_AUDIO_RECORDING=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ANALYTICS=false

# ===========================================
# UI Configuration
# ===========================================
VITE_THEME=light
VITE_LANGUAGE=en
VITE_TIMEZONE=UTC

# ===========================================
# Production Overrides (uncomment for production)
# ===========================================
# NODE_ENV=production
# DB_SSLMODE=require
# JWT_SECRET=your-production-jwt-secret-here
# VITE_NODE_ENV=production
# VITE_DEBUG=false
# VITE_API_URL=https://api.yourdomain.com/api/v1
