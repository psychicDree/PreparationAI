{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "preparationai",
  "compatibility_date": "2026-05-31",
  // Mirrors the dashboard's Observability settings, so deploys from this
  // config don't reset them: persisted logs (including invocation logs) on,
  // tracing off.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Serves the built React app. Cloudflare's Git build runs the dashboard
  // build command (cd frontend && npm ci && npm run build) before deploying.
  "assets": {
    "directory": "./frontend/dist",
    // Unknown paths (e.g. /interview/123) get index.html so React Router can
    // handle them.
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Required by `wrangler preview`, which Cloudflare's Git build runs for
  // branches other than main. Empty means previews use the settings above.
  "previews": {}
}
